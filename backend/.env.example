# ---------------------------------------------------------------------
# Conexao com o PostgreSQL
# ---------------------------------------------------------------------

# Usada pela aplicacao no dia a dia. O ideal e que aponte para um usuario
# que so consiga ler e escrever nas tabelas da agenda, sem poderes de
# administrador. Veja prisma/least-privilege.sql para criar esse usuario.
DATABASE_URL="postgresql://usuario:senha@localhost:5432/agenda?schema=public"

# Opcional, porem recomendado. Usada SOMENTE ao aplicar migrations, que
# precisam criar e alterar tabelas. Deve apontar para o usuario
# administrativo do banco. Se ficar vazia, as migrations usam a DATABASE_URL.
MIGRATION_DATABASE_URL=""

# ---------------------------------------------------------------------
# Sessao e acesso
# ---------------------------------------------------------------------

# Segredo usado para assinar o cookie de sessao. Quem tiver este valor
# consegue forjar uma sessao valida, entao trate como senha.
# Gere um valor novo com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="troque-este-valor-por-uma-chave-aleatoria-longa"

# PIN inicial de acesso. So e usado na primeira execucao, quando o banco
# ainda nao tem configuracao gravada. Depois disso, troque em Configuracoes.
# Use pelo menos 6 digitos.
ACCESS_PIN="123456"

# Quantos dias a sessao continua valida sem digitar o PIN de novo.
SESSION_DAYS=7

# ---------------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------------

PORT=4000

# Endereco do frontend em desenvolvimento. Em producao pode ficar vazio:
# o backend entrega o proprio frontend, entao nao ha origem externa para
# liberar, e deixar vazio e o mais seguro.
CORS_ORIGIN="http://localhost:5173"

NODE_ENV=development
