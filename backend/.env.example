# Conexao com o PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agenda?schema=public"

# Segredo usado para assinar o cookie de sessao.
# Gere um valor novo com:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="troque-este-valor-por-uma-chave-aleatoria-longa"

# PIN inicial de acesso. So e usado na primeira execucao, quando o banco
# ainda nao tem configuracao gravada. Depois disso, troque em Configuracoes.
ACCESS_PIN="1234"

# Quantos dias a sessao continua valida sem digitar o PIN de novo.
SESSION_DAYS=7

# Porta da API
PORT=4000

# Endereco do frontend em desenvolvimento
CORS_ORIGIN="http://localhost:5173"

NODE_ENV=development
